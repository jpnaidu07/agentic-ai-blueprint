# Copy using setup.ps1/setup.sh, which generate unique local identities.
APP_ENV=development
AUTH_USERS=[]
DATABASE_URL=sqlite:///data/tender.sqlite
POSTGRES_PASSWORD=
BIND_HOST=127.0.0.1
ENABLE_DEMO_ROUTES=false

# No model is hard-coded. Select a supported model/deployment and approved endpoint.
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=
LLM_TOP_P=
LLM_MAX_TOKENS=2048
LLM_CONTEXT_WINDOW=32768
LLM_TIMEOUT=30
LLM_RETRIES=1
LLM_STRUCTURED_OUTPUT=false
LLM_TOOL_CALLING=false
LLM_FALLBACK_MODEL=
LLM_EMBEDDING_MODEL=
LLM_LATENCY_PREFERENCE=balanced
LLM_COST_PREFERENCE=balanced
# Explicitly approve sending document text to your selected provider before enabling.
ALLOW_DOCUMENT_LLM=false
