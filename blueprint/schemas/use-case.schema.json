{
  "$defs": {
    "Requirement": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Z][A-Z0-9-]{1,39}$",
          "title": "Id",
          "type": "string"
        },
        "objective": {
          "minLength": 10,
          "title": "Objective",
          "type": "string"
        },
        "acceptance": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Acceptance",
          "type": "array"
        },
        "skill": {
          "enum": [
            "backend",
            "database",
            "frontend",
            "agents",
            "rag",
            "infrastructure",
            "security"
          ],
          "title": "Skill",
          "type": "string"
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "blueprint_modules": {
          "items": {
            "maximum": 8,
            "minimum": 1,
            "type": "integer"
          },
          "title": "Blueprint Modules",
          "type": "array"
        }
      },
      "required": [
        "id",
        "objective",
        "acceptance",
        "skill"
      ],
      "title": "Requirement",
      "type": "object"
