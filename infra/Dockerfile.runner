FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt requirements-dev.txt /tmp/blueprint-dependencies/
RUN pip install --no-cache-dir -r /tmp/blueprint-dependencies/requirements-dev.txt
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app
USER 65534:65534
CMD ["python", "-m", "pytest", "-q", "-p", "no:cacheprovider", "tests"]
